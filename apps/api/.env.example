APP_NAME=Digitra API
ENVIRONMENT=development

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

ACTIVE_MODEL_VERSION=digitra-tid-robust-v5.0.0
MODELS_DIR=../../models

# "browser" keeps STT/TTS entirely client-side (no API key needed).
# Switch to "cloud" or "local" once a real provider is wired in.
STT_PROVIDER=browser
TTS_PROVIDER=browser
CLOUD_STT_API_KEY=
CLOUD_TTS_API_KEY=
# Claude key for the voice assistant's free-form answers. Leave empty to use
# ANTHROPIC_API_KEY / `ant auth login` instead; commands work without it.
LLM_API_KEY=
